{
  "name": "trabalhofinal-fiaq",
  "version": "1.0.0",
  "description": "fIAq — portal de FAQ e assistente virtual com IA do CIC/UnB. O app fica em fiaq-app/ (Nuxt 4).",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "cross-env TMPDIR=/tmp NUXT_TELEMETRY_DISABLED=1 pnpm --dir fiaq-app dev",
    "build": "pnpm --dir fiaq-app build",
    "preview": "pnpm --dir fiaq-app preview",
    "lint": "pnpm --dir fiaq-app lint",
    "typecheck": "pnpm --dir fiaq-app typecheck",
    "build:faq": "pnpm --dir fiaq-app build:faq",
    "seed:faq": "pnpm --dir fiaq-app seed:faq",
    "seed:knowledge": "pnpm --dir fiaq-app seed:knowledge",
    "fetch:links": "pnpm --dir fiaq-app fetch:links",
    "index:rag": "pnpm --dir fiaq-app index:rag",
    "test:openrouter": "pnpm --dir fiaq-app test:openrouter"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
