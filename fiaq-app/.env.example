# ─── Providers de LLM / Embeddings ──────────────────────────────────────────
# Valores: "ollama" (local, padrão) ou "openrouter"
CHAT_PROVIDER=ollama
EMBED_PROVIDER=ollama

# ─── OpenRouter (necessário se algum provider acima for "openrouter") ────────
OPENROUTER_API_KEY=
# Roteador gratuito de modelos de chat/texto do OpenRouter.
OPENROUTER_CHAT_MODEL=openrouter/free
# Embeddings precisam ficar no mesmo modelo/dimensão usados no seed do RAG.
# Não use openrouter/free aqui: ele é roteador de chat, não endpoint de embeddings.
OPENROUTER_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# ─── Ollama (local) — sobrescreve os defaults se quiser ──────────────────────
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Opcional ────────────────────────────────────────────────────────────────
# URL pública do app, usada no header HTTP-Referer do OpenRouter (atribuição).
# Na Vercel é preenchida automaticamente via VERCEL_URL; defina só se quiser fixar.
# APP_URL=https://seu-dominio.vercel.app

# ─── Banco de Dados ───────────────────────────────────────────────────────────
# Postgres local (Docker, sem SSL):
# DATABASE_URL=postgresql://fiaq:fiaq123@localhost:5432/fiaq
# Banco gerenciado (Neon, Supabase, Vercel Postgres — com SSL obrigatório):
# DATABASE_URL=postgresql://usuario:senha@host:5432/fiaq?sslmode=require
# Supabase + Vercel: prefira a Transaction Pooler URI (porta 6543) com SSL.
# O app usa postgres.js com prepare=false para compatibilidade com o pooler.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@REGIAO.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
